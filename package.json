{
  "name": "eclone-piano",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "EClone Games MIDI visualization studio with Kontakt recording, 60fps export, OBS scenes and desktop overlay",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server/index.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "build:audio": "dotnet build native/audio -c Release",
    "doctor": "node scripts/doctor.mjs",
    "setup": "npm run build:audio && npm run doctor",
    "check": "node scripts/check.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "test:export": "node tests/export/smoke.mjs",
    "format": "prettier --write public server desktop shared scripts tests docs native/**/*.md package.json README.md",
    "docs:images": "node scripts/docs/capture-images.mjs",
    "diagnose:midi": "node scripts/diagnostics/midi-smoke.mjs",
    "diagnose:audio": "node scripts/diagnostics/audio-smoke.mjs",
    "analyze:wav": "node scripts/diagnostics/analyze-wav.mjs",
    "prepare:win": "node scripts/release/prepare.mjs",
    "dist:win": "npm run prepare:win && electron-builder --win --x64 --publish never",
    "test:packaged": "node tests/desktop/packaged.mjs",
    "release:files": "node scripts/release/artifacts.mjs",
    "test:installer": "node tests/desktop/installer.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^39.2.7",
    "electron-builder": "26.18.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "EClone Games",
  "repository": {
    "type": "git",
    "url": "https://github.com/EcchiClone/eclone-piano.git"
  },
  "homepage": "https://github.com/EcchiClone/eclone-piano#readme",
  "bugs": {
    "url": "https://github.com/EcchiClone/eclone-piano/issues"
  },
  "productName": "EClone Piano"
}
